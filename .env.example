# SOC Automation Lab: every variable the lab reads.
#
# Do not copy this file by hand. Run scripts/setup/init.sh, which writes .env
# with a fresh random value for each secret. This file only documents them.

# ---------------------------------------------------------------- core stack
# Elasticsearch password for the "elastic" user (index for TheHive and Cortex)
ELASTIC_PASSWORD=CHANGE_ME

# Session secrets
THEHIVE_SECRET=CHANGE_ME
CORTEX_SECRET=CHANGE_ME

# Shuffle. The API key must be a UUID. The OpenSearch password needs upper
# case, lower case, a digit and a symbol.
SHUFFLE_VERSION=2.3.0
SHUFFLE_OPENSEARCH_PASSWORD=CHANGE_ME
SHUFFLE_DEFAULT_USERNAME=admin
SHUFFLE_DEFAULT_PASSWORD=CHANGE_ME
SHUFFLE_DEFAULT_APIKEY=CHANGE_ME
SHUFFLE_ENCRYPTION_MODIFIER=CHANGE_ME

# Accounts that scripts/setup/provision.py creates
THEHIVE_ADMIN_PASSWORD=CHANGE_ME
THEHIVE_ANALYST_LOGIN=analyst@soc.lab
THEHIVE_ANALYST_PASSWORD=CHANGE_ME
CORTEX_ADMIN_PASSWORD=CHANGE_ME
CORTEX_ORGADMIN_PASSWORD=CHANGE_ME

# ------------------------------------------------- scripts/python (optional)
# The scripts read these from the environment. They are not used by docker compose.

# threat_enrichment.py: a service without a key is skipped
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=
SHODAN_API_KEY=
OTX_API_KEY=

# automated_blocking.py
BLOCKLIST_DIR=blocklists
NEVER_BLOCK_FILE=
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=
WAZUH_CA_BUNDLE=
MISP_URL=
MISP_API_KEY=
MISP_CA_BUNDLE=
BLOCK_WEBHOOK_URL=
BLOCK_WEBHOOK_TOKEN=
BLOCK_WEBHOOK_CA_BUNDLE=
