# SOC Automation Lab - Environment Configuration
# Copy this file to .env and update with your values

# ===========================================
# ELASTICSEARCH
# ===========================================
ELASTIC_PASSWORD=changeme

# ===========================================
# THEHIVE
# ===========================================
THEHIVE_SECRET=changeme-use-strong-random-key

# ===========================================
# CORTEX
# ===========================================
CORTEX_API_KEY=your-cortex-api-key

# ===========================================
# MISP
# ===========================================
MISP_DB_PASSWORD=misp
MISP_DB_ROOT_PASSWORD=misp_root
MISP_ADMIN_PASSWORD=admin
MISP_API_KEY=your-misp-api-key

# ===========================================
# SHUFFLE SOAR
# ===========================================
SHUFFLE_ENCRYPTION_KEY=shuffle_encryption_key_minimum_32_chars
SHUFFLE_USERNAME=admin
SHUFFLE_PASSWORD=shuffle
SHUFFLE_API_KEY=

# ===========================================
# WAZUH
# ===========================================
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=wazuh

# ===========================================
# GRAFANA
# ===========================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ===========================================
# THREAT INTELLIGENCE API KEYS
# ===========================================
# VirusTotal - https://www.virustotal.com/
VIRUSTOTAL_API_KEY=

# AbuseIPDB - https://www.abuseipdb.com/
ABUSEIPDB_API_KEY=

# Shodan - https://www.shodan.io/
SHODAN_API_KEY=

# GreyNoise - https://www.greynoise.io/
GREYNOISE_API_KEY=

# URLScan - https://urlscan.io/
URLSCAN_API_KEY=

# AlienVault OTX - https://otx.alienvault.com/
OTX_API_KEY=

# ===========================================
# EXTERNAL INTEGRATIONS (Optional)
# ===========================================
# Firewall API
FIREWALL_API_URL=
FIREWALL_API_KEY=
FIREWALL_TYPE=pfsense

# Web Proxy API
PROXY_API_URL=
PROXY_API_KEY=
PROXY_TYPE=squid

# EDR API
EDR_API_URL=
EDR_API_KEY=
EDR_TYPE=crowdstrike

# ===========================================
# NOTIFICATION SERVICES (Optional)
# ===========================================
# Slack
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# PagerDuty
PAGERDUTY_API_KEY=
PAGERDUTY_SERVICE_ID=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=soc@company.com
